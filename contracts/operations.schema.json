        },
        "track_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60963840000000
