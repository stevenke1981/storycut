        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "muted": {
          "type": "boolean"
        },
        "fade_in_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60963840000000
        },
        "fade_out_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60963840000000
        },
        "fade_curve": {
          "type": "string",
          "enum": [
            "linear_amplitude"
